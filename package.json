{
  "name": "at-assemblage",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Visual node interface for your Semble collections on the AT Protocol",
  "scripts": {
    "lex:install": "lex install --ci",
    "lex:build": "lex build --lexicons ./lexicons --out ./src/lexicons --clear --index-file",
    "postinstall": "npm run lex:build",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@atproto/lex-json": "^0.1.7",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@atcute/client": "^5.1.2",
    "@atcute/oauth-browser-client": "^5.1.0",
    "@atproto/common-web": "^0.5.15",
    "@atproto/lex": "^0.4.0",
    "@atproto/lex-cbor": "^0.1.7",
    "@atproto/lex-client": "^0.4.0",
    "@atproto/lex-data": "^0.1.8",
    "@atproto/lex-password-session": "^0.3.0",
    "@atproto/syntax": "^0.7.7",
    "@hookform/resolvers": "^5.9.2",
    "@tanstack/react-query": "^5.104.5",
    "@xyflow/react": "^12.12.0",
    "elkjs": "^0.12.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.15"
  }
}

# Service used for com.atproto.identity.resolveHandle (no credentials are sent here)
VITE_HANDLE_RESOLVER=https://public.api.bsky.app
# PLC directory used to resolve did:plc documents
VITE_PLC_DIRECTORY=https://plc.directory
# Link previews for new cards (title/description). The pasted URL is sent here. Empty = off.
VITE_LINK_PREVIEW_SERVICE=https://cardyb.bsky.app/v1/extract
# Public origin of the deployed site (no trailing slash). Used for absolute
# og:image / og:url tags, and OAuth client metadata is generated from it.
VITE_SITE_URL=https://assemblage.renderg.host
# Semble's public API, used for card suggestions (the selected card's URL is sent). Empty = off.
VITE_SEMBLE_API=https://api.semble.so
